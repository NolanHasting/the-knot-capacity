{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/history",
        "function": {
          "functionId": "getHistory",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/status",
        "function": {
          "functionId": "getOccupancy",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/feedback",
        "function": {
          "functionId": "submitFeedback",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/event",
        "function": {
          "functionId": "recordProductEvent",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/admin",
        "function": {
          "functionId": "getAdminDashboard",
          "region": "us-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "/api/@(history|feedback|event|admin)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
